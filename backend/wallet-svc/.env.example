# Application Environment Configuration
APP_NAME=wallet-svc
APP_ENV=development
PORT=8080
ROUTE_PREFIX=/api/v1
SHUTDOWN_TIMEOUT=10s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
TRUSTED_PROXIES=
# Default: Mongo ObjectId hex (24 chars). Set empty to disable.
USER_ID_PATTERN=^[a-fA-F0-9]{24}$
# APP pool shards per app_id (sticky by hash(user_id)). Higher = less lock contention.
APP_WALLET_SHARDS=16

# Logging
LOG_LEVEL=info
LOG_FORMAT=console

# PostgreSQL — API uses wallet_app (DML). Migrations use MIGRATE_DATABASE_URL.
# If the password has special chars (@ # $ % ! etc), URL-encode them
# (e.g. @ → %40, # → %23, $ → %24, ! → %21).
DATABASE_URL=postgresql://wallet_app:wallet_app_password@localhost:5432/wallet?sslmode=disable
MIGRATE_DATABASE_URL=postgresql://wallet_migrate:wallet_migrate_password@localhost:5432/wallet?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m
DB_LOCK_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=5s

# Redis
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# RabbitMQ AMQP 1.0 (Orders → wallet.commands x-consistent-hash by user_id). Off by default.
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=wallet.commands
RABBITMQ_QUEUE_PREFIX=wallet.commands
RABBITMQ_SHARD_TOTAL=16
RABBITMQ_SHARD_COUNT=1
RABBITMQ_SHARD_INDEX=0
RABBITMQ_COMMANDS_DLQ=wallet.commands.dlq
RABBITMQ_EVENTS_EXCHANGE=wallet.events
RABBITMQ_OUTBOX_POLL_INTERVAL=1s
RABBITMQ_PUBLISH_TIMEOUT=5s
RABBITMQ_PREFETCH=10

# HMAC secret used to verify service JWTs (HS256). Min 32 bytes.
# Callers send Authorization: Bearer <jwt> and X-Scopes header.
# JWT_SECRET_PREV supports rotation (both accepted until cutover).
JWT_SECRET=dev-only-jwt-secret-change-me-now!!!!!!

# Limits
MAX_CREDIT_AMOUNT=1000000
MAX_DEBIT_AMOUNT=1000000
MAX_WALLET_BALANCE=10000000
DAILY_CREDIT_CAP=2000000

# Rate limit
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL=1s

# CORS
CORS_ALLOWED_ORIGINS=*
