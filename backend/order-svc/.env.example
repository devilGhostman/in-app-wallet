APP_NAME=order-svc
APP_ENV=development
PORT=8082
ROUTE_PREFIX=/api/v1
SHUTDOWN_TIMEOUT=10s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
TRUSTED_PROXIES=
# Default: Mongo ObjectId hex (24 chars). Set empty to disable.
USER_ID_PATTERN=^[a-fA-F0-9]{24}$

LOG_LEVEL=info
LOG_FORMAT=console

DATABASE_URL=postgresql://order_app:order_app_password@localhost:5432/orders?sslmode=disable
MIGRATE_DATABASE_URL=postgresql://order_migrate:order_migrate_password@localhost:5432/orders?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT=5s

REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# RabbitMQ AMQP 1.0: publish commands → wallet.commands; consume lifecycle ← order.wallet.lifecycle
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=wallet.commands
RABBITMQ_EVENTS_QUEUE=order.wallet.lifecycle
RABBITMQ_OUTBOX_POLL_INTERVAL=1s
RABBITMQ_PUBLISH_TIMEOUT=5s
RABBITMQ_PREFETCH=10

JWT_SECRET=dev-only-jwt-secret-change-me-now!!!!!!
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret!!!!!
PAYMENT_WEBHOOK_URL=http://localhost:8082/api/v1/webhooks/payment

MAX_ORDER_AMOUNT=1000000
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL=1s
CORS_ALLOWED_ORIGINS=*
