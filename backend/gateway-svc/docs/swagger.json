{
  "swagger": "2.0",
  "info": {
    "description": "Edge gateway: JWT auth, rate limit, reverse proxy to wallet-svc and order-svc.",
    "title": "Gateway Service API",
    "version": "1.0"
  },
  "host": "localhost:8081",
  "basePath": "/api/v1",
  "paths": {
    "/healthz": {
      "get": {
        "produces": ["application/json"],
        "tags": ["health"],
        "summary": "Liveness probe",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/readyz": {
      "get": {
        "produces": ["application/json"],
        "tags": ["health"],
        "summary": "Readiness probe (Redis)",
        "responses": {
          "200": { "description": "OK" },
          "503": { "description": "Redis unavailable" }
        }
      }
    },
    "/internal/wallets": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["proxy"],
        "summary": "Proxy to wallet-svc",
        "responses": {
          "200": { "description": "Upstream response" },
          "401": { "description": "Unauthorized" },
          "503": { "description": "Upstream / circuit open" }
        }
      }
    },
    "/internal/orders": {
      "post": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["proxy"],
        "summary": "Proxy to order-svc",
        "responses": {
          "201": { "description": "Upstream response" },
          "401": { "description": "Unauthorized" },
          "503": { "description": "Upstream / circuit open" }
        }
      }
    },
    "/webhooks/payment": {
      "post": {
        "tags": ["proxy"],
        "summary": "Payment webhook (auth bypass)",
        "responses": {
          "200": { "description": "Upstream response" },
          "429": { "description": "Rate limited" }
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}
